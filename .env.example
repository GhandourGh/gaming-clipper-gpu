/Users/macos/.zshenv:.:1: no such file or directory: /Users/macos/.cargo/env
# Copy to .env. Never commit .env.
CLIPPER_DB_PASSWORD=change-me
# Shared secret n8n sends in the X-Clipper-Token header.
CLIPPER_TOKEN=change-me
CLIPPER_PORT=8787
# mlx-whisper model (HF repo). Smaller = faster: mlx-community/whisper-small-mlx
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
GEMINI_MODEL=gemini-3.1-flash-lite
# USD per 1M tokens, used only for cost estimates
GEMINI_USD_IN_PER_M=0.25
GEMINI_USD_OUT_PER_M=1.50
RETENTION_DAYS=7
# Parallel clip processing on one RTX GPU. Start at 2; raise only after a real
# multi-clip benchmark shows enough VRAM headroom.
GPU_THREADS=2
QC_THREADS=2
INGEST_THREADS=2
LLM_THREADS=3
# Hard ceiling for any replacement Pod selected by deployment tooling or an operator.
# The existing Pod may be grandfathered separately; replacements must not exceed this.
MAX_REPLACEMENT_GPU_USD_PER_HOUR=0.20

# ---- Optional integrations (leave empty to skip; the dashboard Settings page shows which keys are set) ----
# Music: Freesound (CC0 only) -> Jamendo (CC BY / BY-SA) -> Openverse (no key). https://freesound.org/apiv2/apply
FREESOUND_API_KEY=
# https://devportal.jamendo.com
JAMENDO_CLIENT_ID=
# LLM fallback when Gemini hits quota/5xx: same Gemini model via OpenRouter, then Groq (3 frames, no video)
OPENROUTER_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Groq does not return a cost; used for estimates (USD per 1M tokens)
GROQ_USD_IN_PER_M=0.50
GROQ_USD_OUT_PER_M=1.50
# Trend hints for hooks/titles: ShortsIntel (3 credits/lookup, 1,000 free) or TrendsMCP (100 free requests/month)
SHORTSINTEL_API_KEY=
SHORTSINTEL_PLATFORM=tiktok   # tiktok | youtube | instagram (YouTube results carry no hashtags)
TRENDSMCP_API_KEY=
# TrendsMCP board for get_top_trends
TRENDSMCP_BOARD=Google Trends
# Publishing (drafts held for approval; Publish stays locked until enabled in Settings). Video posts need a paid Ayrshare plan.
AYRSHARE_API_KEY=
GEMINI_FREE_TIER=0
BUDGET_SINCE=

# Live recording (Live page): Twitch viewer clips as a moment signal (optional; dev.twitch.tv app, client credentials)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# LIVE_ENABLED=1  LIVE_POLL_S=90  LIVE_CHUNK_S=1800  LIVE_MIN_FREE_GB=10  LIVE_KEEP_DAYS=3
# MIN_CLIPS=3  (clip floor per job)  FLOOR_QUALITY_DROP=2.0
